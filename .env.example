# ComplianceGuard AI Environment Variables
# Copy this file to .env and update with your actual values

# ====================
# Application Settings
# ====================
ENVIRONMENT=development  # development | staging | production
DEBUG=True
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars

# ====================
# Database Configuration
# ====================
DATABASE_URL=postgresql://complianceguard:secure_password@localhost:5432/complianceguard
DB_PASSWORD=secure_password

# Database Connection Pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ====================
# Redis Configuration
# ====================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ====================
# Celery Configuration
# ====================
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_ALWAYS_EAGER=False  # Set to True for testing without Celery

# ====================
# S3 Storage Configuration
# ====================
# AWS credentials are automatically loaded from:
# 1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# 2. AWS credentials file (~/.aws/credentials)
# 3. IAM role (if running on EC2/ECS/Lambda)

# Required: Set your S3 bucket name
S3_BUCKET_NAME=your-bucket-name-here
S3_REGION=us-east-1

# Optional: Override local AWS credentials (uncomment only if needed)
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional: Use LocalStack/MinIO for local development
# S3_ENDPOINT_URL=http://localhost:4566
# S3_USE_SSL=False

# ====================
# Landing AI Configuration
# ====================
# Get your API key from: https://landing.ai/
LANDING_AI_API_KEY=your_landing_ai_api_key_here
LANDING_AI_BASE_URL=https://api.landing.ai/v1
LANDING_AI_TIMEOUT_SECONDS=60
LANDING_AI_MAX_RETRIES=3

# ====================
# AWS Bedrock Configuration
# ====================
# AWS credentials are shared with S3 - loaded from your computer automatically
# Region for Bedrock (can be different from S3 region)
AWS_REGION=us-east-1

# Optional: Override AWS credentials (same as S3 section)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Bedrock model settings
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_MAX_TOKENS=8000
AWS_BEDROCK_TEMPERATURE=0.1

# ====================
# File Processing Settings
# ====================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=[".pdf",".docx"]
EXTRACTION_TIMEOUT_SECONDS=120

# ====================
# Compliance Settings
# ====================
COMPLIANCE_FRAMEWORKS=["SEC_CYBER"]
VIOLATION_SEVERITY_LEVELS=["critical","high","medium","low"]
MAX_PARALLEL_DOCUMENT_COMPARISONS=10

# ====================
# API Settings
# ====================
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=True
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# ====================
# Monitoring & Observability (Optional)
# ====================
# Sentry error tracking
SENTRY_DSN=

# Metrics
ENABLE_METRICS=True
METRICS_PORT=9090

# Distributed tracing
ENABLE_TRACING=False
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ====================
# Flower (Celery Monitoring)
# ====================
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ====================
# Docker Build Settings
# ====================
BUILD_TARGET=development  # development | production